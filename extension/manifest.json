{
  "manifest_version": 3,
  "name": "Toolbar Controls for Amazon Music",
  "version": "1.2.0",
  "description": "Play/pause, next and previous for the Amazon Music web player, in your toolbar. Not affiliated with or endorsed by Amazon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "amazon-music-toolbar@ffam.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "121",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "*://music.amazon.com/*",
    "*://music.amazon.co.uk/*",
    "*://music.amazon.de/*",
    "*://music.amazon.fr/*",
    "*://music.amazon.it/*",
    "*://music.amazon.es/*",
    "*://music.amazon.ca/*",
    "*://music.amazon.com.au/*",
    "*://music.amazon.co.jp/*",
    "*://music.amazon.in/*",
    "*://music.amazon.com.br/*",
    "*://music.amazon.com.mx/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ],
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.amazon.com/*",
        "*://music.amazon.co.uk/*",
        "*://music.amazon.de/*",
        "*://music.amazon.fr/*",
        "*://music.amazon.it/*",
        "*://music.amazon.es/*",
        "*://music.amazon.ca/*",
        "*://music.amazon.com.au/*",
        "*://music.amazon.co.jp/*",
        "*://music.amazon.in/*",
        "*://music.amazon.com.br/*",
        "*://music.amazon.com.mx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toolbar Controls for Amazon Music",
    "default_popup": "popup/popup.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
